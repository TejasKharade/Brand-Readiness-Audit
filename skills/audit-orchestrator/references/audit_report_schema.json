{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BrandAIReadinessAuditReport",
  "type": "object",
  "required": [
    "site",
    "audited_at",
    "category_scores",
    "summary",
    "findings",
    "proactive_recommendations",
    "audit_metadata"
  ],
  "properties": {
    "site": {
      "type": "string",
      "description": "Target website domain or URL audited"
    },
    "audited_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of audit execution"
    },
    "category_scores": {
      "type": "object",
      "description": "Five independent, self-contained scores (0-100), one per audit category. Each starts at 100 and is reduced by a fixed amount per finding in that category (critical -20, high -10, medium -5, low -2), scaled by the finding's confidence -- no cross-category weighting, no overall blended score, no caps. A category's number can be verified by hand directly from the findings list.",
      "required": [
        "crawl_access",
        "crawl_render",
        "readability",
        "freshness_corroboration",
        "engagement"
      ],
      "properties": {
        "crawl_access": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
        "crawl_render": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
        "readability": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
        "freshness_corroboration": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
        "engagement": { "type": "number", "minimum": 0.0, "maximum": 100.0 }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_findings", "critical", "high", "medium", "low"],
      "properties": {
        "total_findings": { "type": "integer", "minimum": 0 },
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "title", "severity", "evidence", "suggested_action"],
        "properties": {
          "id": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
          "category": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "evidence": { "type": "string" },
          "suggested_action": {
            "type": "object",
            "required": ["summary", "priority"],
            "properties": {
              "summary": { "type": "string" },
              "priority": { "type": "string", "enum": ["critical", "high", "medium", "low"] }
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "How sure this finding is real, distinct from severity (how bad it'd be if true). Defaults to 1.0 (full weight); scales how much this finding deducts from its category's score."
          }
        }
      }
    },
    "proactive_recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audit_metadata": {
      "type": "object",
      "required": ["audited_pages_count", "skills_invoked_count", "marketplace_version"],
      "properties": {
        "audited_pages_count": { "type": "integer", "minimum": 1 },
        "skills_invoked_count": { "type": "integer", "minimum": 1 },
        "marketplace_version": { "type": "string" }
      }
    }
  }
}
