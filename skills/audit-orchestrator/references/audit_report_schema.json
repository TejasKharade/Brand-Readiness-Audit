{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BrandAIReadinessAuditReport",
  "type": "object",
  "required": [
    "site",
    "audited_at",
    "brand_ai_readiness_score",
    "category_scores",
    "summary",
    "findings",
    "proactive_recommendations",
    "audit_metadata"
  ],
  "properties": {
    "site": {
      "type": "string",
      "description": "Target website domain or URL audited"
    },
    "audited_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of audit execution"
    },
    "brand_ai_readiness_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0,
      "description": "Overall Brand AI Readiness Score (0-100)"
    },
    "category_scores": {
      "type": "object",
      "required": [
        "crawl_access",
        "crawl_render",
        "readability",
        "freshness_corroboration",
        "engagement"
      ],
      "properties": {
        "crawl_access": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
        "crawl_render": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
        "readability": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
        "freshness_corroboration": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
        "engagement": { "type": "number", "minimum": 0.0, "maximum": 100.0 }
      }
    },
    "scoring_model": {
      "type": "object",
      "description": "How brand_ai_readiness_score was rolled up from category_scores: prerequisite-weighted mean plus foundational gates that cap the overall score when a critical finding lands in crawl_access or crawl_render.",
      "properties": {
        "method": { "type": "string" },
        "weights": { "type": "object" },
        "weighted_subtotal": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
        "gates_applied": { "type": "array", "items": { "type": "object" } },
        "category_deduction_detail": {
          "type": "object",
          "description": "Per category, per severity present: hit count, the confidence-weighted+decayed total actually deducted, and what a flat (no diminishing-returns) model would have charged -- the gap between the two is the diminishing-returns effect.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "count": { "type": "integer", "minimum": 0 },
                "deducted": { "type": "number" },
                "flat_equivalent": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_findings", "critical", "high", "medium", "low"],
      "properties": {
        "total_findings": { "type": "integer", "minimum": 0 },
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "title", "severity", "evidence", "suggested_action"],
        "properties": {
          "id": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
          "category": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "evidence": { "type": "string" },
          "suggested_action": {
            "type": "object",
            "required": ["summary", "priority"],
            "properties": {
              "summary": { "type": "string" },
              "priority": { "type": "string", "enum": ["critical", "high", "medium", "low"] }
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "How sure this finding is real, distinct from severity (how bad it'd be if true). Defaults to 1.0 (full weight); scales its scoring impact and, for a critical finding, softens the foundational-gate cap it would otherwise trigger."
          }
        }
      }
    },
    "proactive_recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audit_metadata": {
      "type": "object",
      "required": ["audited_pages_count", "skills_invoked_count", "marketplace_version"],
      "properties": {
        "audited_pages_count": { "type": "integer", "minimum": 1 },
        "skills_invoked_count": { "type": "integer", "minimum": 1 },
        "marketplace_version": { "type": "string" }
      }
    }
  }
}
